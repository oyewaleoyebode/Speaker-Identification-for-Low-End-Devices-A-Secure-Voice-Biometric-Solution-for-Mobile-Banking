#Speaker Diarization

import os
import csv
from pyannote.audio import Pipeline

# Initialize the PyAnnote pipeline for speaker diarization
pipeline = Pipeline.from_pretrained("pyannote/speaker-diarization@2.1", use_auth_token='')

# Define the directory containing folders of speakers
dataset_directory = "/work/oluwatobi-o/Whisper_Validation/Dataset_2/yoruba_dataset"

# Output CSV file to save diarization results
output_csv_path = "/work/oluwatobi-o/Whisper_Validation/Dataset_2/diarization_results.csv" 

# Open the output CSV file in write mode
with open(output_csv_path, mode='w', newline='') as csvfile:
    csv_writer = csv.writer(csvfile)
    # Write the header row
    csv_writer.writerow(["Speaker Folder", "Audio File", "Speaker Label", "Start Time (s)", "End Time (s)"])

    # Iterate through each speaker's folder
    for speaker_folder in os.listdir(dataset_directory):
        speaker_folder_path = os.path.join(dataset_directory, speaker_folder)
        # Ensure we are processing only directories (speaker folders)
        if os.path.isdir(speaker_folder_path):
            print(f"Processing folder: {speaker_folder_path}")

            # Iterate through each audio file in the speaker's folder
            for audio_file in os.listdir(speaker_folder_path):
                audio_file_path = os.path.join(speaker_folder_path, audio_file)
                # Ensure the file is a .wav audio file
                if audio_file_path.endswith('.wav'):
                    print(f"  Analyzing file: {audio_file_path}")

                    # Perform diarization on the audio file
                    diarization_result = pipeline(audio_file_path)

                    # Save diarization results (timestamps and speaker labels) to CSV
                    for segment, _, speaker in diarization_result.itertracks(yield_label=True):
                        start_time = segment.start
                        end_time = segment.end
                        # Write the row to the CSV file
                        csv_writer.writerow([speaker_folder, audio_file, speaker, start_time, end_time])
                        print(f"    Speaker {speaker}: {start_time:.2f}s to {end_time:.2f}s")

print(f"Diarization results saved to {output_csv_path}")
