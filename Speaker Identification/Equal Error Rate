#Equal Error Rate

import os
import torch
import numpy as np
from sklearn.metrics import roc_curve
from sklearn.preprocessing import StandardScaler
from torch.utils.data import DataLoader, TensorDataset
from tqdm import tqdm  # Progress bar for better monitoring

# Directory for embeddings
embedding_output_directory = "/work/oluwatobi-o/Speaker_Identification/Combined_Speakers_embeddings"

# Load Embeddings and Labels Efficiently
X_data, y_data = [], []
speaker_label_mapping = {}
label_counter = 0

print("Loading Embeddings and Labels...")
for speaker_folder in tqdm(os.listdir(embedding_output_directory)):
    speaker_folder_path = os.path.join(embedding_output_directory, speaker_folder)
    
    if os.path.isdir(speaker_folder_path):
        if speaker_folder not in speaker_label_mapping:
            speaker_label_mapping[speaker_folder] = label_counter
            label_counter += 1

        for embedding_file in os.listdir(speaker_folder_path):
            embedding_path = os.path.join(speaker_folder_path, embedding_file)
            embedding = np.load(embedding_path)
            X_data.append(embedding)
            y_data.append(speaker_label_mapping[speaker_folder])

# Convert to NumPy arrays
X_data = np.array(X_data)
y_data = np.array(y_data)

# Normalize embeddings using StandardScaler
scaler = StandardScaler()
X_data = scaler.fit_transform(X_data)

# Convert to PyTorch tensors
X_data = torch.tensor(X_data, dtype=torch.float32)
y_data = torch.tensor(y_data, dtype=torch.long)

# DataLoader for Batch Processing
val_dataset = TensorDataset(X_data, y_data)
val_loader = DataLoader(val_dataset, batch_size=512, shuffle=False)  # Larger batch size for faster computation

# Load Trained Model
class WhisperSpeakerRecognitionModel(torch.nn.Module):
    def __init__(self, input_dim, num_classes):
        super(WhisperSpeakerRecognitionModel, self).__init__()
        self.fc1 = torch.nn.Linear(input_dim, 256)
        self.relu = torch.nn.ReLU()
        self.dropout = torch.nn.Dropout(0.3)
        self.fc2 = torch.nn.Linear(256, 128)
        self.fc3 = torch.nn.Linear(128, num_classes)

    def forward(self, x):
        x = self.fc1(x)
        x = self.relu(x)
        x = self.dropout(x)
        x = self.fc2(x)
        x = self.relu(x)
        x = self.fc3(x)
        return x

# Initialize Model
input_dim = X_data.shape[1]
num_speakers = len(speaker_label_mapping)
model = WhisperSpeakerRecognitionModel(input_dim, num_speakers)

# Load saved model
model_save_path = "/work/oluwatobi-o/Speaker_Identification/saved_whisper_model.pth"
model.load_state_dict(torch.load(model_save_path))
model.eval()

# Function to Calculate EER
def calculate_eer(y_true, y_proba):
    fpr, tpr, thresholds = roc_curve(y_true, y_proba)
    fnr = 1 - tpr
    eer_threshold_index = np.nanargmin(np.abs(fnr - fpr))
    eer = (fpr[eer_threshold_index] + fnr[eer_threshold_index]) / 2
    return eer

# Calculate EER for Each Speaker
speaker_eer = []

with torch.no_grad():
    print("Calculating EER for Each Speaker...")
    for speaker_id in tqdm(range(num_speakers)):
        speaker_probs = []
        speaker_labels = []

        for batch_x, batch_y in val_loader:
            outputs = model(batch_x)
            probabilities = torch.nn.functional.softmax(outputs, dim=1).cpu().numpy()
            
            # Get the probabilities and labels for the current speaker
            speaker_probs.extend(probabilities[:, speaker_id])
            speaker_labels.extend((batch_y.cpu().numpy() == speaker_id).astype(int))

        # Calculate EER for current speaker
        eer = calculate_eer(speaker_labels, speaker_probs)
        speaker_eer.append(eer)
        print(f"EER for Speaker {speaker_id}: {eer:.4f}")

# Calculate Average EER
average_eer = np.mean(speaker_eer)
print(f"\n✅ Average Equal Error Rate (EER) for all Speakers: {average_eer:.4f}")
