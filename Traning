#Using Whisper to pre-train
import os
import torch
import numpy as np
from torch.utils.data import DataLoader, TensorDataset
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score
from transformers import WhisperModel, WhisperProcessor
import torch.nn as nn

# Load Whisper model from Hugging Face Transformers
whisper_model_name = "openai/whisper-base"
whisper_model = WhisperModel.from_pretrained(whisper_model_name)
whisper_processor = WhisperProcessor.from_pretrained(whisper_model_name)

# Directory for combined embeddings
embedding_output_directory = "/work/oluwatobi-o/Whisper_Validation/Dataset_2/combined_embeddings"

# Load embeddings and labels
X_train, y_train = [], []
speaker_label_mapping = {}
label_counter = 0

# Load embeddings from the directory
for speaker_folder in os.listdir(embedding_output_directory):
    speaker_folder_path = os.path.join(embedding_output_directory, speaker_folder)
    
    if os.path.isdir(speaker_folder_path):
        if speaker_folder not in speaker_label_mapping:
            speaker_label_mapping[speaker_folder] = label_counter
            label_counter += 1

        for embedding_file in os.listdir(speaker_folder_path):
            embedding_path = os.path.join(speaker_folder_path, embedding_file)
            embedding = np.load(embedding_path)
            X_train.append(embedding)
            y_train.append(speaker_label_mapping[speaker_folder])

# Normalize embeddings using StandardScaler
scaler = StandardScaler()
X_train = scaler.fit_transform(np.array(X_train))

# Convert lists to tensors and create a DataLoader
X_train = torch.tensor(X_train, dtype=torch.float32)
y_train = torch.tensor(y_train, dtype=torch.long)
train_dataset = TensorDataset(X_train, y_train)
train_loader = DataLoader(train_dataset, batch_size=32, shuffle=True)

# Define the model using Whisper embeddings
class WhisperSpeakerRecognitionModel(nn.Module):
    def __init__(self, input_dim, num_classes):
        super(WhisperSpeakerRecognitionModel, self).__init__()
        self.fc1 = nn.Linear(input_dim, 256)
        self.relu = nn.ReLU()
        self.fc2 = nn.Linear(256, 128)
        self.fc3 = nn.Linear(128, num_classes)

    def forward(self, x):
        x = self.fc1(x)
        x = self.relu(x)
        x = self.fc2(x)
        x = self.relu(x)
        x = self.fc3(x)
        return x

# Initialize the model
input_dim = 1472  # Use the size of Whisper embeddings or adjust accordingly
num_speakers = len(speaker_label_mapping)
model = WhisperSpeakerRecognitionModel(input_dim, num_speakers)

# Training process
optimizer = torch.optim.Adam(model.parameters(), lr=0.001, weight_decay=1e-5)
criterion = nn.CrossEntropyLoss()

# Training loop
num_epochs = 100
for epoch in range(num_epochs):
    model.train()
    epoch_loss = 0
    for batch_x, batch_y in train_loader:
        outputs = model(batch_x)
        loss = criterion(outputs, batch_y)
        optimizer.zero_grad()
        loss.backward()
        optimizer.step()
        epoch_loss += loss.item()

    print(f"Epoch {epoch + 1}/{num_epochs}, Loss: {epoch_loss / len(train_loader)}")

# Save the trained model
model_save_path = "/work/oluwatobi-o/Whisper_Validation/Dataset_2/saved_whisper_model.pth"
torch.save(model.state_dict(), model_save_path)
print(f"Model saved to {model_save_path}")

# Evaluation function
def evaluate_model(model, data_loader):
    model.eval()  # Set the model to evaluation mode
    all_preds = []
    all_labels = []
    
    with torch.no_grad():
        for batch_x, batch_y in data_loader:
            outputs = model(batch_x)
            _, preds = torch.max(outputs, 1)  # Get the predicted classes
            all_preds.extend(preds.cpu().numpy())
            all_labels.extend(batch_y.cpu().numpy())
    
    # Calculate metrics
    accuracy = accuracy_score(all_labels, all_preds)
    precision = precision_score(all_labels, all_preds, average='weighted')
    recall = recall_score(all_labels, all_preds, average='weighted')
    f1 = f1_score(all_labels, all_preds, average='weighted')
    
    print(f"Accuracy: {accuracy:.4f}")
    print(f"Precision: {precision:.4f}")
    print(f"Recall: {recall:.4f}")
    print(f"F1 Score: {f1:.4f}")

# Evaluate the model on the training data (or use a separate validation set if available)
evaluate_model(model, train_loader)
