        speaker_embedding_dir = os.path.join(embedding_path, speaker_folder)
        speaker_spectral_dir = os.path.join(spectral_path, speaker_folder)

        if os.path.isdir(speaker_embedding_dir) and os.path.isdir(speaker_spectral_dir):
            # Process each file in the speaker's embedding directory
            for embedding_file_name in os.listdir(speaker_embedding_dir):
                # Extract the common identifier (e.g., "audio_10" or "norm_aug_audio_10")
                identifier = embedding_file_name.split("_combined.npy")[0]
                
                # Search for a matching spectral file with the identifier
                spectral_file_name = next((f for f in os.listdir(speaker_spectral_dir) if identifier in f and f.endswith(".wav_features.npy")), None)
                
                if spectral_file_name:
                    embedding_file = os.path.join(speaker_embedding_dir, embedding_file_name)
                    spectral_file = os.path.join(speaker_spectral_dir, spectral_file_name)

                    # Load embedding and spectral feature
                    embedding = np.load(embedding_file)
                    spectral_feature = np.load(spectral_file)

                    # Combine embedding and spectral features
                    combined_features = np.concatenate([embedding, spectral_feature])
                    features.append(combined_features)
                    labels.append(label)
